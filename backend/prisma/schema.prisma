// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
}

model Sneaker {
  id Int @id @default(autoincrement())
  name String 
  description String
  brand String
  mrp Decimal
  createdAt DateTime @default(now())

  colorways SneakerColorway[]
}

model SneakerColorway {
  id Int @id @default(autoincrement())
  sneakerId Int
  sneaker Sneaker @relation(fields:[sneakerId], references:[id])
  color String
  colorCode String
  
  variants SneakerVariant[]
  images SneakerImage[]
}

model SneakerVariant {
  id Int @id @default(autoincrement())
  colorwayId Int
  colorway SneakerColorway @relation(fields:[colorwayId], references:[id])
  size String
  discountedPrice Decimal
  stock Int

  orderItems OrderItem[]
  cartItems CartItem[]
}

model SneakerImage{
  id Int @id @default(autoincrement())
  colorwayId Int
  colorway SneakerColorway @relation(fields:[colorwayId], references:[id])
  url String
  indexNo Int
  isThumbnail Boolean @default(false)
}

model User {
  id Int @id @default(autoincrement())
  name String 
  email String @unique
  hashedPassword String
  role Role @default(USER)
  createdAt DateTime @default(now())

  orders Order[]
  cart Cart?
}

model Order {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields:[userId], references:[id])
  status OrderStatus
  purchasedDate DateTime @default(now())

  orderItems OrderItem[]
}

model OrderItem {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields:[orderId], references:[id])
  variantId Int
  variant SneakerVariant @relation(fields:[variantId], references:[id])
  quantity Int
  purchasedPrice Decimal
}

model Cart {
  id Int @id @default(autoincrement())
  userId Int @unique
  user User @relation(fields:[userId], references:[id])

  cartItems CartItem[]
}

model CartItem {
  id Int @id @default(autoincrement())
  cartId Int
  cart Cart @relation(fields:[cartId], references:[id])
  variantId Int
  variant SneakerVariant @relation(fields:[variantId], references:[id])
  quantity Int

  @@unique([cartId, variantId])
}
